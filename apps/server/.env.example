# Application environment ('dev' or 'prod')
APP_ENV=dev
PORT=3000

# Database Configuration (PostgreSQL / Neon)
# Option A: Connection Strings (Recommended for Neon Cloud Postgres)
# DATABASE_URL uses the Neon connection pooler (-pooler suffix) for runtime traffic & GraphQL API
DATABASE_URL=postgresql://neondb_owner:password@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_DIRECT_URL uses the direct compute endpoint (without -pooler) for TypeORM schema migrations & DDL
DATABASE_DIRECT_URL=postgresql://neondb_owner:password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Discrete Parameters (Local development fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vakaa
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_SYNCHRONIZE=false

# Authentication & Security
COOKIE_SECRET=vakaa_secret_cookie_key_change_in_production
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# SebPay.africa Multi-Rail Payment Gateway
# Obtain test/live API keys from https://new.sebpay.bj
# PAUSED by default until the provider is verified: with SEBPAY_ENABLED=false the
# SebPay payment method is disabled (hidden from checkout) and the handler
# declines. Set SEBPAY_ENABLED=true only after verifying SebPay and completing a
# real settlement test.
SEBPAY_ENABLED=false
SEBPAY_PUBLIC_KEY=pk_test_your_public_key
SEBPAY_SECRET_KEY=sk_test_your_secret_key
SEBPAY_SANDBOX=true
SEBPAY_WEBHOOK_URL=http://localhost:3000/payments/sebpay/webhook

# Flutterwave Multi-Rail Payment Gateway (Cards, Mobile Money, USSD)
# Obtain sandbox test keys from https://dashboard.flutterwave.com
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key
FLW_SECRET_HASH=vakaa_flw_secret_hash
FLW_SANDBOX=true
FLW_WEBHOOK_URL=http://localhost:3000/payments/flutterwave/webhook

# Brevo (Sendinblue) Transactional Email
# Obtain SMTP key from Brevo: Transactional -> Settings -> Configuration (or SMTP & API)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
EMAIL_FROM_ADDRESS="VAKÁA" <orders@vakaa.store>
EMAIL_DEV_MODE=true

# Cloudflare R2 Object Storage (S3-Compatible)
# When set, Vendure automatically streams and stores all product assets in Cloudflare R2 ($0 egress fees)
R2_BUCKET_NAME=vakaa-assets
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# Optional: Connect a custom domain (e.g. https://assets.vakaa.store/) or public r2.dev domain
# If omitted, Vendure serves/optimizes images through its own /assets route
ASSET_URL_PREFIX=