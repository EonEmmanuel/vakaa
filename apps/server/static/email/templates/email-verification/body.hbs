{{> header title="Vérification de votre compte / Email Verification" }}

<mj-section background-color="#FFFFFF" padding="36px 24px 20px 24px">
    <mj-column width="100%">
        <mj-text font-size="20px" font-weight="700" color="#18181B" padding-bottom="8px">
            Bienvenue chez VAKÁA / <em>Welcome to VAKÁA</em>
        </mj-text>
        <mj-text font-size="14px" color="#52525B" line-height="22px" padding-bottom="12px">
            Nous vous remercions pour la création de votre compte client. Afin de sécuriser vos informations et finaliser votre inscription, veuillez confirmer votre adresse email en cliquant sur le bouton ci-dessous :
        </mj-text>
        <mj-text font-size="13px" color="#71717A" line-height="20px" padding-bottom="24px">
            <em>Thank you for creating an account with us. Please click the button below to verify your email address and activate your account:</em>
        </mj-text>

        <mj-button background-color="#18181B"
                   color="#FFFFFF"
                   font-size="13px"
                   font-weight="600"
                   letter-spacing="0.05em"
                   border-radius="4px"
                   inner-padding="14px 28px"
                   padding-bottom="24px"
                   href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}">
            Confirmer mon adresse email &bull; Verify Email
        </mj-button>

        <mj-divider border-color="#E4E4E7" border-width="1px" padding="16px 0" />

        <mj-text font-size="12px" color="#A1A1AA" line-height="18px">
            Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet email en toute sécurité.<br />
            <em>If you did not initiate this request, you can safely disregard this email.</em>
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
