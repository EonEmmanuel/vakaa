<mjml>
    <mj-head>
        <mj-title>{{ title }} | Maison VAKÁA</mj-title>
        <mj-font name="Playfair Display" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
        <mj-attributes>
            <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
            <mj-text font-size="14px" color="#27272A" line-height="1.6" />
        </mj-attributes>
        <mj-style inline="inline">
            .brand-title {
                font-family: 'Playfair Display', Georgia, 'Times New Roman', serif !important;
                letter-spacing: 0.28em !important;
                font-weight: 700 !important;
                text-transform: uppercase !important;
                color: #140C06 !important;
            }
            .brand-subtitle {
                letter-spacing: 0.18em !important;
                text-transform: uppercase !important;
                font-size: 10px !important;
                font-weight: 600 !important;
                color: #9B6327 !important;
            }
            .gold-badge {
                display: inline-block !important;
                background-color: #FBF7EE !important;
                border: 1px solid #E4D3A8 !important;
                color: #7D5A1E !important;
                font-size: 11px !important;
                font-weight: 600 !important;
                padding: 4px 10px !important;
                border-radius: 999px !important;
                letter-spacing: 0.06em !important;
            }
            .order-pill {
                background-color: #140C06 !important;
                color: #FFFFFF !important;
                padding: 8px 16px !important;
                border-radius: 999px !important;
                font-weight: 600 !important;
                font-size: 13px !important;
                display: inline-block !important;
                letter-spacing: 0.05em !important;
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#FAF8F5">
        <!-- VAKÁA editorial masthead -->
        <mj-section background-color="#FFFFFF" padding="38px 24px 22px 24px">
            <mj-column width="100%">
                <mj-image src="{{ storefrontUrl }}/images/vakaa-logo-dark.png"
                          alt="VAKÁA — Haute Maroquinerie d'Art"
                          align="center"
                          height="52px"
                          width="154px"
                          padding="0 0 12px 0"
                          fluid-on-mobile="false" />
                <mj-text align="center" css-class="brand-subtitle" padding="0">
                    Haute Maroquinerie d'Art &bull; Douala, Cameroun
                </mj-text>
            </mj-column>
        </mj-section>
        <mj-section background-color="#E4D3A8" padding="1px 0">
        </mj-section>
