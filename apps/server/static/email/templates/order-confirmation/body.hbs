{{> header title="Confirmation de commande / Order Confirmation" }}

<mj-raw>
    <style type="text/css">
        .receipt-card {
            background-color: #FFFFFF;
            border-radius: 12px;
        }
        .order-meta-box {
            background-color: #FAF8F5;
            border: 1px solid #ECE4DA;
            border-radius: 10px;
        }
        .product-table {
            width: 100%;
            border-collapse: collapse;
        }
        .product-table tr td {
            padding: 14px 4px;
            border-bottom: 1px solid #F3EDE4;
            vertical-align: middle;
        }
        .total-row td {
            border-top: 1px solid #9B6327 !important;
            border-bottom: none !important;
            padding-top: 16px !important;
            font-size: 16px !important;
            font-weight: 700 !important;
            color: #140C06 !important;
        }
        .serif-greeting {
            font-family: 'Playfair Display', Georgia, 'Times New Roman', serif !important;
            font-size: 23px !important;
            font-weight: 700 !important;
            color: #140C06 !important;
            letter-spacing: 0.01em !important;
        }
    </style>
</mj-raw>

<!-- Greeting & Status -->
<mj-section background-color="#FFFFFF" padding="34px 24px 14px 24px">
    <mj-column width="100%">
        <mj-text css-class="serif-greeting" padding-bottom="6px">
            Merci pour votre commande, {{ order.customer.firstName }}.
        </mj-text>
        <mj-text font-size="13px" color="#71717A" line-height="21px" padding-bottom="18px">
            Votre commande a bien été enregistrée et transmise à nos ateliers pour préparation.<br />
            <em>Thank you for your order. It has been confirmed and is being prepared with care.</em>
        </mj-text>

        <!-- Order Meta Callout -->
        <mj-table padding="14px 16px" css-class="order-meta-box">
            <tr>
                <td style="padding: 8px 12px; width: 33%;">
                    <div style="font-size: 10px; color: #8C7B70; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Commande / Order</div>
                    <div style="font-size: 14px; font-weight: 700; color: #140C06; margin-top: 4px;">#{{ order.code }}</div>
                </td>
                <td style="padding: 8px 12px; width: 33%;">
                    <div style="font-size: 10px; color: #8C7B70; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Date</div>
                    <div style="font-size: 13px; font-weight: 600; color: #4A3A2F; margin-top: 4px;">{{ formatDate order.orderPlacedAt 'dd/mm/yyyy' }}</div>
                </td>
                <td style="padding: 8px 12px; width: 34%; text-align: right;">
                    <div style="font-size: 10px; color: #8C7B70; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Statut / Status</div>
                    <div style="margin-top: 4px;"><span class="gold-badge">&bull; Payée / Paid</span></div>
                </td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<!-- Order Line Items -->
<mj-section background-color="#FFFFFF" padding="0 24px 16px 24px">
    <mj-column width="100%">
        <mj-text font-size="12px" font-weight="700" color="#9B6327" letter-spacing="0.14em" padding-bottom="4px">
            ARTICLES COMMANDÉS / ITEMS ORDERED
        </mj-text>

        <mj-table cellpadding="0" css-class="product-table">
            {{#each order.lines }}
            <tr>
                <td style="width: 56px; padding: 12px 0;">
                    {{#if featuredAsset}}
                    <img src="{{ featuredAsset.preview }}"
                         alt="{{ productVariant.name }}"
                         style="width: 52px; height: 52px; object-fit: cover; border-radius: 8px; border: 1px solid #ECE4DA; display: block;" />
                    {{else}}
                    <div style="width: 52px; height: 52px; background: #FAF8F5; border-radius: 8px; border: 1px solid #ECE4DA;"></div>
                    {{/if}}
                </td>
                <td style="padding-left: 14px;">
                    <div style="font-weight: 600; font-size: 14px; color: #140C06;">{{ productVariant.name }}</div>
                    <div style="font-size: 12px; color: #8C7B70; margin-top: 3px;">Quantité / Qty : {{ quantity }}</div>
                </td>
                <td style="text-align: right; font-weight: 600; font-size: 14px; color: #140C06; white-space: nowrap;">
                    {{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'fr' }}
                </td>
            </tr>
            {{/each}}

            {{#each order.discounts }}
            <tr>
                <td colspan="2" style="color: #7D5A1E; font-weight: 500; font-size: 13px;">
                    Remise / Discount ({{ description }}) :
                </td>
                <td style="text-align: right; color: #7D5A1E; font-weight: 600; font-size: 13px;">
                    -{{ formatMoney amount ../order.currencyCode 'fr' }}
                </td>
            </tr>
            {{/each}}

            <tr>
                <td colspan="2" style="color: #8C7B70; font-size: 13px; padding-top: 16px;">
                    Sous-total / Subtotal :
                </td>
                <td style="text-align: right; color: #4A3A2F; font-size: 13px; padding-top: 16px;">
                    {{ formatMoney order.subTotalWithTax order.currencyCode 'fr' }}
                </td>
            </tr>

            {{#each shippingLines }}
            <tr>
                <td colspan="2" style="color: #8C7B70; font-size: 13px;">
                    Livraison / Shipping ({{ shippingMethod.name }}) :
                </td>
                <td style="text-align: right; color: #4A3A2F; font-size: 13px;">
                    {{ formatMoney priceWithTax ../order.currencyCode 'fr' }}
                </td>
            </tr>
            {{/each}}

            <tr class="total-row">
                <td colspan="2">
                    Total :
                </td>
                <td style="text-align: right; color: #140C06; font-size: 18px; font-weight: 700;">
                    {{ formatMoney order.totalWithTax order.currencyCode 'fr' }}
                </td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<!-- Shipping Address & Order Tracking CTA -->
<mj-section background-color="#FFFFFF" padding="8px 24px 34px 24px">
    <mj-column width="100%">
        <mj-divider border-color="#ECE4DA" border-width="1px" padding="8px 0 16px 0" />
        <mj-text font-size="12px" font-weight="700" color="#9B6327" letter-spacing="0.14em" padding-bottom="6px">
            ADRESSE DE LIVRAISON / DELIVERY ADDRESS
        </mj-text>
        {{#with order.shippingAddress }}
        <mj-text font-size="13px" color="#4A3A2F" line-height="21px">
            <strong>{{ fullName }}</strong><br />
            {{#if company}}{{ company }}<br />{{/if}}
            {{#if streetLine1}}{{ streetLine1 }}<br />{{/if}}
            {{#if streetLine2}}{{ streetLine2 }}<br />{{/if}}
            {{ city }}{{#if postalCode}}, {{ postalCode }}{{/if}}<br />
            {{ country }}<br />
            {{#if phoneNumber}}Tél / Phone : {{ phoneNumber }}<br />{{/if}}
        </mj-text>
        {{/with}}

        {{#if storefrontUrl}}
        <mj-button background-color="#140C06"
                   color="#FFFFFF"
                   font-size="12px"
                   font-weight="600"
                   letter-spacing="0.08em"
                   border-radius="999px"
                   inner-padding="15px 30px"
                   padding-top="24px"
                   href="{{ storefrontUrl }}/order-confirmation/{{ order.code }}">
            Suivre ma commande &bull; Track My Order
        </mj-button>
        <mj-button background-color="#FFFFFF"
                   color="#140C06"
                   border="1px solid #C9BCAE"
                   font-size="12px"
                   font-weight="600"
                   letter-spacing="0.08em"
                   border-radius="999px"
                   inner-padding="14px 28px"
                   padding-top="10px"
                   href="{{ storefrontUrl }}/account/orders/{{ order.code }}">
            Télécharger ma facture &bull; Download Invoice
        </mj-button>
        {{/if}}
    </mj-column>
</mj-section>

{{> footer }}
