{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@/gql": [
        "./src/gql/graphql.ts"
      ],
      "@/vdb/*": [
        "../../node_modules/.bun/node_modules/@vendure/dashboard/src/lib/*",
        "../../node_modules/@vendure/dashboard/src/lib/*"
      ],
      "react": [
        "../../node_modules/.bun/node_modules/react"
      ],
      "react/*": [
        "../../node_modules/.bun/node_modules/react/*"
      ]
    }
  },
  "include": [
    "src/plugins/**/dashboard/*",
    "src/gql/**/*.ts",
    "vite.*.*ts"
  ]
}
